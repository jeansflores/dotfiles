# Ghostty — Gruvbox Material
# Referência completa: `ghostty +show-config --default --docs | less`
# Temas disponíveis:  `ghostty +list-themes`

# Variantes: "Gruvbox Material Dark" | "Gruvbox Dark Hard" | "Gruvbox Dark" | "Gruvbox Material Light"
# Cuidado: o tema chamado só "Gruvbox Material" não é o Material — traz outra
# paleta (azul #6da3ec, vermelho #ea6926). O certo é o "Gruvbox Material Dark".
theme = Gruvbox Material Dark

# O tema embutido vem com o fundo medium (#282828); o resto da sessão usa o
# hard, então sobrescrevo aqui.
background = #1d2021

font-family = "JetBrainsMono Nerd Font Mono"
font-size = 11
font-feature = calt
font-feature = liga

window-padding-x = 10
window-padding-y = 8
window-padding-balance = true

# No Sway o título é desenhado pelo compositor, não pelo GTK
window-decoration = none

# Leve transparência — descomente se quiser (Sway não faz blur atrás)
# background-opacity = 0.95

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

scrollback-limit = 10000
copy-on-select = clipboard

shell-integration = detect
shell-integration-features = cursor,sudo,title

confirm-close-surface = false
