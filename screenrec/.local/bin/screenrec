#!/usr/bin/env bash
#
# screenrec — gravação de tela com wf-recorder, no mesmo espírito dos prints
#
# Uso:
#   screenrec toggle [alvo]   inicia (ou para, se já estiver gravando)
#   screenrec start  [alvo]   inicia; alvo = region (padrão) | screen | "X,Y WxH"
#   screenrec stop            para e avisa onde ficou o arquivo
#   screenrec status          imprime "recording <segundos>" ou "idle"
#   screenrec waybar          JSON para o módulo custom/recording
#
# Tela cheia codifica por GPU (h264_vaapi no Radeon) e cai para libx264 por CPU
# se a VA-API não subir. Região vai sempre de CPU — ver is_fullscreen. O arquivo
# vai para ~/Videos/Screencasts.
#
set -euo pipefail

# Cores do tema ativo. Este source injeta os 16 papéis como variáveis globais
# (bg_dark, bg, bg_hl, fg, fg_dim, comment, blue, blue1, cyan, magenta, purple,
# green, yellow, orange, red, teal) — não use esses nomes para outra coisa aqui.
# Sem o arquivo, o slurp cai nos defaults da própria linha.
THEME_ENV="${XDG_STATE_HOME:-$HOME/.local/state}/theme.env"
# shellcheck source=/dev/null
[[ -r "$THEME_ENV" ]] && source "$THEME_ENV"

OUT_DIR="${XDG_VIDEOS_DIR:-$HOME/Videos}/Screencasts"
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/screenrec"
PID_FILE="$RUN_DIR/pid"
INFO_FILE="$RUN_DIR/info"      # linha 1: arquivo · linha 2: epoch do início

VAAPI_DEV=/dev/dri/renderD128

# Precisa bater com "signal" no módulo da waybar
WAYBAR_SIGNAL=9

# Janela pra decidir se o encoder subiu. Dá só pra flagrar o que morre sozinho
# (encoder indisponível) — ver o comentário do launch sobre o que NÃO dá.
LAUNCH_TRIES=6
LAUNCH_INTERVAL=0.25
MIN_VALID_BYTES=1024           # abaixo disso o mp4 é só cabeçalho, sem frame

# nf-fa-circle, em escape pra não sumir em copy-paste de uso privado
ICON=$'\uf111'

refresh_waybar() {
    pkill -RTMIN+$WAYBAR_SIGNAL waybar 2>/dev/null || true
}

notify() {
    notify-send -a screenrec -i camera-video -t 3000 "$@" 2>/dev/null || true
}

# Vivo de verdade. Um filho já morto e ainda não colhido responde ao kill -0
# como zumbi, e isso faria o reap escalar até o SIGKILL sem necessidade.
alive() {
    local pid=$1 state
    kill -0 "$pid" 2>/dev/null || return 1
    state=$(sed -n 's/^State:[[:space:]]*\(.\).*/\1/p' "/proc/$pid/status" 2>/dev/null)
    [[ $state != Z ]]
}

# Encerra o wf-recorder e só volta quando ele realmente morreu. SIGINT primeiro,
# para ele fechar o container mp4; se travou no grafo de filtros ele captura o
# sinal e não age, então escalamos para SIGTERM e SIGKILL. Sem escalar, a parada
# apagava o estado e deixava o processo órfão girando em 100% de um núcleo.
# Deixa em REAP_SIGNAL o sinal que de fato o derrubou (vazio se já estava morto).
REAP_SIGNAL=''
reap() {
    local pid=$1; shift
    local sigs=("$@") sig i waits
    (( ${#sigs[@]} )) || sigs=(INT TERM KILL)
    REAP_SIGNAL=''
    for sig in "${sigs[@]}"; do
        alive "$pid" || break
        # o SIGINT leva folga pro wf-recorder fechar o moov do mp4; depois dele
        # já sabemos que o processo não está colaborando, então não vale esperar
        [[ $sig == INT ]] && waits=50 || waits=20
        REAP_SIGNAL=$sig
        kill -"$sig" "$pid" 2>/dev/null || true
        for i in $(seq "$waits"); do
            alive "$pid" || break 2
            sleep 0.1
        done
    done
    wait "$pid" 2>/dev/null || true     # colhe o zumbi, se for nosso filho
    ! alive "$pid"
}

recording_pid() {
    local pid
    [[ -r "$PID_FILE" ]] || return 1
    pid=$(<"$PID_FILE")
    [[ -n "$pid" ]] && alive "$pid" || { rm -f "$PID_FILE" "$INFO_FILE"; return 1; }
    printf '%s' "$pid"
}

# A captura de REGIÃO com h264_vaapi está quebrada nesta pilha (wf-recorder
# 0.6.0): o grafo de filtros recusa o frame ("Changing video frame properties on
# the fly", csp gbr vs unknown), nada é gravado, o processo gira em 100% de um
# núcleo e não responde a SIGINT. Tela cheia pela GPU funciona normalmente, e
# região por CPU também — num recorte pequeno o libx264 custa quase nada.
# Medido em 2026-09-16; se o wf-recorder consertar isso, some com esta função.
# Falha de swaymsg/jq cai no lado seguro (CPU).
is_fullscreen() {
    swaymsg -t get_outputs \
        | jq -e --arg g "$1" '[.[] | .rect | "\(.x),\(.y) \(.width)x\(.height)"] | index($g)' \
        >/dev/null 2>&1
}

# Geometria "X,Y WxH" do alvo pedido
geometry_for() {
    case "${1:-region}" in
        region)
            slurp -d -b "${bg_dark:-#1d2021}80" -c "${red:-#ea6962}ff" -s '#00000000' -w 2
            ;;
        screen)
            swaymsg -t get_outputs \
                | jq -r '.[] | select(.focused) | .rect | "\(.x),\(.y) \(.width)x\(.height)"'
            ;;
        *[0-9]*,*x*)
            printf '%s' "$1"
            ;;
        *)
            printf 'alvo desconhecido: %s\n' "$1" >&2
            return 1
            ;;
    esac
}

# Sobe o wf-recorder com os argumentos extras dados; retorna 1 se ele morrer na
# janela de checagem, deixando o processo já colhido — nunca solto.
#
# Só o encoder indisponível dá pra flagrar aqui. Um encoder que trava DENTRO do
# grafo de filtros é indistinguível de uma gravação saudável neste ponto: medido
# nesta máquina, com a tela parada o muxer do mp4 fica no cabeçalho por 2-4s
# antes de descarregar 256KB de uma vez, e o processo saudável consome 0,5-1,3
# núcleo — os mesmos sinais do travado. Quem cobre o travamento é o cmd_stop,
# que agora sempre consegue matar, e o indicador da waybar, que agora nunca
# desaparece com o processo vivo.
launch() {
    local geom=$1 file=$2; shift 2
    wf-recorder -g "$geom" -f "$file" "$@" >/dev/null 2>"$RUN_DIR/log" &
    local pid=$!

    local i
    for i in $(seq "$LAUNCH_TRIES"); do
        sleep "$LAUNCH_INTERVAL"
        if ! alive "$pid"; then
            reap "$pid" KILL || true    # colhe o zumbi antes de devolver falha
            return 1
        fi
    done
    printf '%s' "$pid"
}

cmd_start() {
    if recording_pid >/dev/null; then
        printf 'já está gravando\n' >&2
        return 1
    fi

    local geom
    geom=$(geometry_for "${1:-region}") || exit 0     # Esc no slurp cancela
    [[ -n "$geom" ]] || exit 0

    mkdir -p "$OUT_DIR" "$RUN_DIR"
    local file="$OUT_DIR/$(date +'%Y-%m-%d_%H-%M-%S').mp4"
    local pid encoder=CPU

    # Tela cheia tenta a GPU e cai pra CPU se a VA-API não subir; região vai
    # direto de CPU, porque h264_vaapi em recorte trava (ver is_fullscreen).
    if is_fullscreen "$geom" && pid=$(launch "$geom" "$file" -c h264_vaapi -d "$VAAPI_DEV"); then
        encoder=GPU
    else
        rm -f "$file"
        pid=$(launch "$geom" "$file" -c libx264 -p preset=veryfast) || {
            notify -u critical 'Gravação falhou' "$(tail -n 3 "$RUN_DIR/log")"
            exit 1
        }
    fi

    printf '%s\n' "$pid" > "$PID_FILE"
    printf '%s\n%s\n' "$file" "$(date +%s)" > "$INFO_FILE"
    refresh_waybar
    notify 'Gravando a tela' "Codificador: $encoder · Mod+Shift+R para parar"
}

cmd_stop() {
    local pid file
    pid=$(recording_pid) || { printf 'nenhuma gravação em andamento\n' >&2; return 1; }
    file=$(head -n 1 "$INFO_FILE")

    if ! reap "$pid"; then
        # nem o SIGKILL pegou: preserva o estado pra não perder o rastro do PID
        notify -u critical 'Não consegui parar a gravação' "PID $pid ainda vivo"
        printf 'PID %s não morreu; estado preservado\n' "$pid" >&2
        return 1
    fi

    rm -f "$PID_FILE" "$INFO_FILE"
    refresh_waybar

    local size
    size=$(stat -c %s "$file" 2>/dev/null || printf 0)
    if (( size < MIN_VALID_BYTES )); then
        # só o cabeçalho do mp4: isso passava no [[ -s ]] e anunciava "salva"
        notify -u critical 'Gravação vazia' "$file"
        return 1
    fi

    if [[ $REAP_SIGNAL == KILL ]]; then
        notify -u critical 'Gravação truncada' "$file · precisou de SIGKILL"
    else
        notify 'Gravação salva' "$file"
    fi
    printf '%s\n' "$file"
}

cmd_toggle() {
    if recording_pid >/dev/null; then cmd_stop; else cmd_start "$@"; fi
}

elapsed() {
    local start
    start=$(sed -n 2p "$INFO_FILE")
    printf '%s' $(( $(date +%s) - start ))
}

cmd_status() {
    if recording_pid >/dev/null; then
        printf 'recording %s\n' "$(elapsed)"
    else
        printf 'idle\n'
    fi
}

cmd_waybar() {
    if recording_pid >/dev/null; then
        local s; s=$(elapsed)
        printf '{"text":"%s %02d:%02d","alt":"recording","class":"recording","tooltip":"Gravando a tela · clique para parar"}\n' \
            "$ICON" $(( s / 60 )) $(( s % 60 ))
    else
        # texto vazio = a waybar esconde o módulo
        printf '{"text":"","alt":"idle","class":"idle","tooltip":""}\n'
    fi
}

case "${1:-status}" in
    toggle) shift; cmd_toggle "$@" ;;
    start)  shift; cmd_start "$@" ;;
    stop)   cmd_stop ;;
    status) cmd_status ;;
    waybar) cmd_waybar ;;
    *)
        printf 'uso: %s {toggle [alvo]|start [alvo]|stop|status|waybar}\n' "${0##*/}" >&2
        exit 1
        ;;
esac
