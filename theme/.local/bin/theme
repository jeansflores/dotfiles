#!/usr/bin/env bash
#
# theme — troca o tema da sessão Sway.
#
#   theme get             slug ativo
#   theme set <slug>      aplica e recarrega
#   theme list            slugs disponíveis
#
# Os temas ficam em ~/.local/share/theme/themes/<slug>.theme e os templates em
# ~/.local/share/theme/templates/. Tudo que este script escreve mora fora do
# repositório de dotfiles — trocar de tema nunca deve sujar o git.
set -euo pipefail

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/theme"
THEMES_DIR="$DATA_DIR/themes"
TEMPLATES_DIR="$DATA_DIR/templates"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/theme"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"

DEFAULT_THEME=gruvbox-material

# Ícone de paleta, nf-md-palette (U+F03D8). Escrito como escape de propósito:
# caractere Nerd Font cru dentro de heredoc já quebrou neste repositório.
ICON=$'\U000f03d8'

# Os 16 papéis que todo manifesto precisa ter.
ROLES=(bg_dark bg bg_hl fg fg_dim comment blue blue1 cyan magenta purple
       green yellow orange red teal)

die() { printf 'theme: %s\n' "$*" >&2; exit 1; }

cmd_list() {
    local f
    for f in "$THEMES_DIR"/*.theme; do
        [[ -e "$f" ]] || continue
        basename "$f" .theme
    done
}

cmd_get() {
    local slug=""
    [[ -r "$STATE_FILE" ]] && slug=$(tr -d '[:space:]' < "$STATE_FILE")
    [[ -n "$slug" ]] || slug=$DEFAULT_THEME
    printf '%s\n' "$slug"
}

# load <slug> — valida e dá source no manifesto, deixando os papéis globais.
load() {
    local slug=$1 manifest="$THEMES_DIR/$1.theme"
    [[ -r "$manifest" ]] || {
        printf 'theme: tema desconhecido: %s\n\ndisponíveis:\n' "$slug" >&2
        cmd_list | sed 's/^/  /' >&2
        exit 2
    }
    # shellcheck source=/dev/null
    source "$manifest"

    local role
    for role in "${ROLES[@]}"; do
        [[ -n "${!role:-}" ]] || die "manifesto $slug não define o papel '$role'"
    done
}

# render <template> <destino> — substitui @papel@ e move atomicamente.
render() {
    local tpl="$TEMPLATES_DIR/$1" dest=$2 tmp
    [[ -r "$tpl" ]] || die "template faltando: $tpl"

    # Cada papel vira dois marcadores: @papel@ com a cerquilha e @papel_raw@ sem
    # ela, que é o que o swaylock exige. Explícito no template, em vez de um sed
    # depois adivinhando quais linhas mexer.
    local -a sed_args=()
    local role
    for role in "${ROLES[@]}"; do
        sed_args+=(-e "s|@${role}@|${!role}|g")
        sed_args+=(-e "s|@${role}_raw@|${!role#\#}|g")
    done

    tmp=$(mktemp)
    sed "${sed_args[@]}" "$tpl" > "$tmp"
    mkdir -p "$(dirname "$dest")"
    mv "$tmp" "$dest"
}

# O ghostty tem paleta própria: ou aponta para um tema que ele já traz, ou para
# um arquivo de paleta que vendorizamos (caso dos jellybeans). Por isso não passa
# pelo render genérico dos 16 papéis.
render_ghostty() {
    local dest="$CONFIG_DIR/ghostty/theme.conf" tmp
    tmp=$(mktemp)
    {
        printf '# Gerado por `theme set`. Nao edite: mexa no manifesto do tema.\n'
        if [[ -n "${ghostty_theme:-}" ]]; then
            printf 'theme = %s\n' "$ghostty_theme"
        elif [[ -n "${ghostty_file:-}" ]]; then
            local pal="$DATA_DIR/ghostty/$ghostty_file"
            [[ -r "$pal" ]] || die "paleta de ghostty faltando: $pal"
            cat "$pal"
        else
            die "manifesto sem ghostty_theme nem ghostty_file"
        fi
        [[ -n "${ghostty_extra:-}" ]] && printf '%s\n' "$ghostty_extra"
    } > "$tmp"
    mkdir -p "$(dirname "$dest")"
    mv "$tmp" "$dest"
}

# O btop traz temas prontos para a maioria dos nossos slugs; quando não traz
# (jellybeans), geramos um a partir dos 16 papéis.
apply_btop() {
    local conf="$CONFIG_DIR/btop/btop.conf" name="${btop_theme:-}"
    if [[ -z "$name" ]]; then
        render btop.theme "$CONFIG_DIR/btop/themes/current.theme"
        name=current
    fi
    [[ -f "$conf" ]] || return 0
    sed -i -E "s|^color_theme = \".*\"|color_theme = \"$name\"|" "$conf"
}

# O herdr tem temas próprios, desenhados com o pareamento certo. O tema
# "terminal" dele deriva dos 16 ANSI e acaba pondo o fg sobre o acento — em
# paleta escura os dois são tons claros, e o contraste fica em 1.4-2.8:1, longe
# do mínimo 4.5:1. Por isso o manifesto escolhe um tema do próprio herdr sempre
# que existe equivalente.
render_herdr() {
    local tpl="$TEMPLATES_DIR/herdr.toml" dest="$CONFIG_DIR/herdr/config.toml" tmp
    [[ -r "$tpl" ]] || die "template faltando: $tpl"
    tmp=$(mktemp)
    sed -e "s|@herdr_theme@|${herdr_theme:-terminal}|g" "$tpl" > "$tmp"
    mkdir -p "$(dirname "$dest")"
    mv "$tmp" "$dest"
    herdr server reload-config >/dev/null 2>&1 || true
}

reload() {
    # A waybar sobe por `swaybar_command` no config do sway, então o reload do
    # sway já mata e respawna ela com config e CSS novos. Nada de SIGUSR2 aqui:
    # é redundante, e disputar o controle da barra com o sway só cria corrida.
    swaymsg reload    >/dev/null 2>&1 || true
    swaync-client -rs >/dev/null 2>&1 || true
    # Nada de sinal para a waybar aqui. O reload do sway já a respawna, e o
    # módulo re-executa junto; mandar RTMIN+N por cima pega o processo recém
    # nascido antes de ele instalar o handler, e o default do sinal é terminar.
    # Foi assim que a barra sumiu 1 em 5 trocas.
}

# label_of <slug> — o nome legível do manifesto, ou o próprio slug.
label_of() {
    local slug=$1
    ( source "$THEMES_DIR/$slug.theme" 2>/dev/null; printf '%s' "${label:-$slug}" )
}

cmd_waybar() {
    local cur; cur=$(cmd_get)
    printf '{"text":"%s","tooltip":"Tema: %s","class":"%s"}\n' \
        "$ICON" "$(label_of "$cur")" "$cur"
}

cmd_cycle() {
    local cur next
    cur=$(cmd_get)
    next=$(cmd_list | awk -v c="$cur" '
        {a[NR]=$0}
        END {
            for (i = 1; i <= NR; i++) if (a[i] == c) { print a[i % NR + 1]; exit }
            print a[1]
        }')
    cmd_set "$next"
}

cmd_menu() {
    local cur chosen slug
    cur=$(cmd_get)
    chosen=$(cmd_list | while read -r slug; do
                 if [[ "$slug" == "$cur" ]]; then printf '● %s\n' "$(label_of "$slug")"
                 else                             printf '   %s\n' "$(label_of "$slug")"
                 fi
             done | wofi --dmenu --prompt 'Tema' --width 320 --height 320 \
                         --style "$CONFIG_DIR/wofi/style.css" 2>/dev/null) || return 0
    chosen=${chosen#● }
    chosen=${chosen#   }
    for slug in $(cmd_list); do
        [[ "$(label_of "$slug")" == "$chosen" ]] && { cmd_set "$slug"; return 0; }
    done
}

# Existe por causa do modo de falha calado: se um arquivo gerado sumir, a waybar
# e o wofi sobem SEM estilo nenhum, sem erro em lugar nenhum.
cmd_doctor() {
    local cur rc=0 f
    cur=$(cmd_get)
    printf 'tema ativo: %s\n\n' "$cur"
    for f in "$CONFIG_DIR/waybar/colors.css" "$CONFIG_DIR/sway/colors.conf" \
             "$CONFIG_DIR/swaync/colors.css" "$CONFIG_DIR/wofi/style.css" \
             "$CONFIG_DIR/swaylock/config" "$CONFIG_DIR/ghostty/theme.conf" \
             "$CONFIG_DIR/herdr/config.toml" \
             "$STATE_DIR/theme.env" "$STATE_DIR/theme-nvim"; do
        if [[ -s "$f" ]]; then
            printf '  ok        %s\n' "$f"
        else
            printf '  FALTANDO  %s\n' "$f"
            rc=1
        fi
    done
    [[ $rc -eq 0 ]] || printf '\nrode: theme set %s\n' "$cur"
    return $rc
}

cmd_set() {
    local slug=${1:-}
    [[ -n "$slug" ]] || die "uso: theme set <slug>"
    load "$slug"

    render waybar.css "$CONFIG_DIR/waybar/colors.css"
    render sway.conf  "$CONFIG_DIR/sway/colors.conf"
    render swaync.css "$CONFIG_DIR/swaync/colors.css"
    # style.css inteiro, não um colors.css importado: o wofi carrega CSS por
    # conteúdo e um @import relativo falha calado. Ver o cabeçalho do template.
    render wofi.css   "$CONFIG_DIR/wofi/style.css"
    render swaylock.conf "$CONFIG_DIR/swaylock/config"
    render_ghostty
    render_herdr
    apply_btop

    mkdir -p "$STATE_DIR"
    printf '%s\n' "$slug" > "$STATE_FILE"

    # Para scripts que precisam das cores em runtime (screenrec).
    { local role
      for role in "${ROLES[@]}"; do printf '%s=%s\n' "$role" "${!role}"; done
    } > "$STATE_DIR/theme.env"

    # O nvim lê isto na inicialização para escolher o colorscheme.
    printf '%s\n' "${nvim_colorscheme:-gruvbox-material}" > "$STATE_DIR/theme-nvim"

    reload
}

case "${1:-get}" in
    get)  cmd_get ;;
    list) cmd_list ;;
    set)  shift; cmd_set "$@" ;;
    waybar) cmd_waybar ;;
    cycle)  cmd_cycle ;;
    menu)   cmd_menu ;;
    doctor) cmd_doctor ;;
    *)    printf 'uso: %s {get|set <slug>|list|cycle|menu|waybar|doctor}\n' "$(basename "$0")" >&2; exit 1 ;;
esac
