  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "@comment.todo",
      "scope": [
        "comment keyword.codetag",
        "comment.todo"
      ],
      "settings": {
        "foreground": "#fabd2f",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Keyword / Statement",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "keyword.control.import",
        "keyword.control.module",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.control.flow",
        "keyword.function",
        "keyword.var",
        "keyword.const",
        "keyword.type",
        "keyword.struct",
        "keyword.interface",
        "keyword.map",
        "keyword.channel",
        "keyword.package",
        "keyword.import"
      ],
      "settings": {
        "foreground": "#fb4934",
        "fontStyle": ""
      }
    },
    {
      "name": "@keyword.directive / PreProc",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "keyword.control.preprocessor",
        "keyword.control.at-rule"
      ],
      "settings": {
        "foreground": "#8ec07c",
        "fontStyle": ""
      }
    },
    {
      "name": "Operator / Delimiter",
      "scope": [
        "keyword.operator",
        "keyword.operator.new",
        "keyword.operator.logical",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.arithmetic",
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace",
        "brace"
      ],
      "settings": {
        "foreground": "#fe8019",
        "fontStyle": ""
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "meta.preprocessor.string",
        "string.quoted.double.json",
        "string.template",
        "constant.other.placeholder",
        "string.unquoted"
      ],
      "settings": {
        "foreground": "#b8bb26",
        "fontStyle": "italic"
      }
    },
    {
      "name": "@string.regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b8bb26",
        "fontStyle": "italic"
      }
    },
    {
      "name": "@string.escape / SpecialChar",
      "scope": [
        "constant.character.escape",
        "string.escape",
        "constant.other.placeholder.c"
      ],
      "settings": {
        "foreground": "#fe8019",
        "fontStyle": ""
      }
    },
    {
      "name": "@string.special.url",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#83a598",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Constant / Number / Boolean",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.other.rune",
        "constant.character",
        "support.constant",
        "variable.arguments",
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other.caps"
      ],
      "settings": {
        "foreground": "#d3869b",
        "fontStyle": ""
      }
    },
    {
      "name": "@constant.builtin (nil, iota, undefined)",
      "scope": [
        "constant.language.null",
        "constant.language.nil",
        "constant.language.iota",
        "constant.language.undefined",
        "constant.language.nan",
        "constant.language.infinity"
      ],
      "settings": {
        "foreground": "#fe8019",
        "fontStyle": ""
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.function.function-call",
        "entity.name.method",
        "entity.name.method.function-call",
        "entity.function",
        "entity.name.function.static",
        "meta.function-call.generic",
        "entity.name.function.support",
        "entity.name.function.member",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#b8bb26",
        "fontStyle": "bold"
      }
    },
    {
      "name": "@function.builtin / Special",
      "scope": [
        "support.function.builtin",
        "entity.name.function.support.builtin",
        "support.function.builtin.python",
        "support.function.magic.python"
      ],
      "settings": {
        "foreground": "#fe8019",
        "fontStyle": ""
      }
    },
    {
      "name": "@function.macro / @attribute",
      "scope": [
        "entity.name.function.macro",
        "entity.name.function.preprocessor",
        "meta.attribute",
        "entity.other.attribute-name.decorator",
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator.python",
        "support.type.python"
      ],
      "settings": {
        "foreground": "#8ec07c",
        "fontStyle": ""
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.type.class",
        "support.type",
        "support.class",
        "meta.type.name",
        "meta.return.type",
        "meta.return-type",
        "meta.type.annotation",
        "variable.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.boolean",
        "storage.type.numeric",
        "storage.type.string",
        "storage.type.error",
        "storage.type.byte",
        "storage.type.rune",
        "storage.type.uintptr",
        "storage.type.generic",
        "entity.name.type.primitive",
        "support.type.primitive",
        "support.type.builtin",
        "entity.name.type.any",
        "entity.name.type.comparable"
      ],
      "settings": {
        "foreground": "#fabd2f",
        "fontStyle": ""
      }
    },
    {
      "name": "@constructor",
      "scope": [
        "entity.name.function.constructor",
        "meta.class.constructor",
        "support.function.constructor"
      ],
      "settings": {
        "foreground": "#fe8019",
        "fontStyle": ""
      }
    },
    {
      "name": "@module / @namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "entity.name.type.namespace",
        "entity.name.type.package",
        "entity.name.type.module",
        "variable.other.import",
        "entity.name.import",
        "meta.import variable.other"
      ],
      "settings": {
        "foreground": "#ebdbb2",
        "fontStyle": ""
      }
    },
    {
      "name": "@variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.name",
        "variable.other.readwrite",
        "variable.other.assignment",
        "meta.function-call.arguments",
        "meta.definition.variable",
        "variable.other.readwrite.alias",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#ebdbb2",
        "fontStyle": ""
      }
    },
    {
      "name": "@variable.parameter / @variable.member / @property",
      "scope": [
        "variable.parameter",
        "meta.parameter.type.variable",
        "variable.other.property",
        "variable.other.member",
        "variable.other.object.property",
        "support.variable.property",
        "support.type.property-name",
        "variable.other.readwrite.member",
