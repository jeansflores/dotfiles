  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment todo",
      "scope": [
        "comment keyword.codetag",
        "comment.todo"
      ],
      "settings": {
        "foreground": "#fabd2f",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "keyword.control.import",
        "keyword.control.module",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.control.flow",
        "keyword.function",
        "keyword.var",
        "keyword.const",
        "keyword.type",
        "keyword.map",
        "keyword.channel",
        "keyword.package",
        "keyword.import"
      ],
      "settings": {
        "foreground": "#fb4934",
        "fontStyle": ""
      }
    },
    {
      "name": "struct / interface / class (aqua)",
      "scope": [
        "keyword.struct",
        "keyword.interface",
        "storage.type.struct",
        "storage.type.interface",
        "storage.type.class",
        "storage.type.enum",
        "storage.type.trait",
        "storage.type.class.python"
      ],
      "settings": {
        "foreground": "#8ec07c",
        "fontStyle": ""
      }
    },
    {
      "name": "PreProc / diretiva",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "keyword.control.preprocessor",
        "keyword.control.at-rule"
      ],
      "settings": {
        "foreground": "#8ec07c",
        "fontStyle": ""
      }
    },
    {
      "name": "Operador (laranja)",
      "scope": [
        "keyword.operator",
        "keyword.operator.new",
        "keyword.operator.logical",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.arithmetic",
        "keyword.operator.address",
        "keyword.operator.ellipsis",
        "keyword.operator.channel"
      ],
      "settings": {
        "foreground": "#fe8019",
        "fontStyle": ""
      }
    },
    {
      "name": "Pontuação (cinza claro)",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.begin.bracket",
        "punctuation.definition.end.bracket",
        "punctuation.other",
        "meta.brace",
        "brace"
      ],
      "settings": {
        "foreground": "#a89984",
        "fontStyle": ""
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "meta.preprocessor.string",
        "string.quoted.double.json",
        "string.template",
        "constant.other.placeholder",
        "string.unquoted",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b8bb26",
        "fontStyle": ""
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape",
        "string.escape"
      ],
      "settings": {
        "foreground": "#fe8019",
        "fontStyle": ""
      }
    },
    {
      "name": "URL / link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#83a598",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Constante / número / booleano",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.other.rune",
        "constant.character",
        "support.constant",
        "variable.arguments",
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other.caps"
      ],
      "settings": {
        "foreground": "#d3869b",
        "fontStyle": ""
      }
    },
    {
      "name": "nil / null / iota",
      "scope": [
        "constant.language.null",
        "constant.language.nil",
        "constant.language.iota",
        "constant.language.undefined",
        "constant.language.nan",
        "constant.language.infinity"
      ],
      "settings": {
        "foreground": "#fe8019",
        "fontStyle": ""
      }
    },
    {
      "name": "Função / método (verde, sem negrito)",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.function.function-call",
        "entity.name.method",
        "entity.name.method.function-call",
        "entity.function",
        "entity.name.function.static",
        "meta.function-call.generic",
        "entity.name.function.support",
        "entity.name.function.member",
        "entity.name.function.decorator",
        "entity.name.function.constructor",
        "support.function.constructor"
      ],
      "settings": {
        "foreground": "#b8bb26",
        "fontStyle": ""
      }
    },
    {
      "name": "Builtin (panic, len, append) em vermelho",
      "scope": [
        "support.function.builtin",
        "entity.name.function.support.builtin",
        "support.function.builtin.python",
        "support.function.magic.python",
        "support.function.builtin.shell"
      ],
      "settings": {
        "foreground": "#fb4934",
        "fontStyle": ""
      }
    },
    {
      "name": "Macro / atributo / decorator",
      "scope": [
        "entity.name.function.macro",
        "entity.name.function.preprocessor",
        "meta.attribute",
        "entity.other.attribute-name.decorator",
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#8ec07c",
        "fontStyle": ""
      }
    },
    {
      "name": "Tipo definido por você / da biblioteca (creme)",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.type.class",
        "support.type",
        "support.class",
        "meta.type.name",
        "meta.return.type",
        "meta.return-type",
        "meta.type.annotation",
        "variable.class",
        "entity.name.type.any",
        "entity.name.type.comparable"
      ],
      "settings": {
        "foreground": "#ebdbb2",
        "fontStyle": ""
      }
    },
    {
      "name": "Tipo builtin (amarelo)",
      "scope": [
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.boolean",
        "storage.type.numeric",
        "storage.type.string",
        "storage.type.error",
        "storage.type.byte",
        "storage.type.rune",
        "storage.type.uintptr",
        "storage.type.generic",
        "entity.name.type.primitive",
        "support.type.primitive",
        "support.type.builtin",
        "support.type.python"
      ],
      "settings": {
        "foreground": "#fabd2f",
        "fontStyle": ""
      }
    },
    {
      "name": "Pacote / namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "entity.name.type.namespace",
        "entity.name.type.package",
        "entity.name.type.module",
        "variable.other.import",
        "meta.import variable.other"
      ],
      "settings": {
        "foreground": "#ebdbb2",
        "fontStyle": ""
      }
    },
    {
      "name": "Caminho do import (string)",
      "scope": [
        "entity.name.import"
      ],
      "settings": {
        "foreground": "#b8bb26",
        "fontStyle": ""
      }
    },
    {
      "name": "Variável, parâmetro, campo (creme)",
